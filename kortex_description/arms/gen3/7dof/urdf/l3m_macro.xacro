<?xml version="1.0"?>

<robot name="gen3_arm" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Propagate last link name information because it is the gripper's parent link -->
  <xacro:property name="last_arm_link" value="end_effector_link"/>
  <xacro:property name="PI" value="3.1415926535897931"/>

  <xacro:macro name="load_arm" params="
    parent
    dof
    vision
    prefix
    *origin
    robot_ip
    username:=admin
    password:=admin
    port:=10000
    port_realtime:=10001
    session_inactivity_timeout_ms:=6000
    connection_inactivity_timeout_ms:=2000
    use_internal_bus_gripper_comm:=true
    gripper_joint_name
    gripper_max_velocity:=100.0
    gripper_max_force:=100.0
    use_fake_hardware:=false
    fake_sensor_commands:=false
    sim_gazebo:=false
    sim_isaac:=false
    isaac_joint_commands:=/isaac_joint_commands
    isaac_joint_states:=/isaac_joint_states
    use_external_cable:=false
    initial_positions:=${dict(joint_1=0.0,joint_2=0.0,joint_3=0.0,joint_4=0.0,joint_5=0.0,joint_6=0.0,joint_7=0.0)}
    moveit_active:=false">

    <!-- ros2 control include -->
    <xacro:include filename="$(find kortex_description)/arms/gen3/${dof}dof/urdf/kortex.ros2_control.xacro" />
    <xacro:kortex_ros2_control
      name="${prefix}KortexMultiInterfaceHardware" prefix="${prefix}"
      use_fake_hardware="${use_fake_hardware}"
      fake_sensor_commands="${fake_sensor_commands}"
      sim_gazebo="${sim_gazebo}"
      sim_isaac="${sim_isaac}"
      isaac_joint_commands="${isaac_joint_commands}"
      isaac_joint_states="${isaac_joint_states}"
      tf_prefix=""
      initial_positions="${initial_positions}"
      robot_ip="${robot_ip}"
      username="${username}"
      password="${password}"
      port="${port}"
      port_realtime="${port_realtime}"
      session_inactivity_timeout_ms="${session_inactivity_timeout_ms}"
      connection_inactivity_timeout_ms="${connection_inactivity_timeout_ms}"
      use_internal_bus_gripper_comm="${use_internal_bus_gripper_comm}"
      gripper_max_velocity="${gripper_max_velocity}"
      gripper_max_force="${gripper_max_force}"
      gripper_joint_name="${gripper_joint_name}"/>

    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${prefix}base_link" />
    </joint>
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.000648 -0.000166 0.084487" rpy="0 0 0" />
        <mass
        value="2.06170366" />
      <inertia 
        ixx="0.00511449"
        ixy="-1E-06"
        ixz="3.25E-06"
        iyy="0.00513579"
        iyz="2.518E-05"
        izz="0.00290779" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/base_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/base_link.STL" />
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_J1-J2">
      <inertial>
        <origin
        xyz="0.00011084 -0.00708926 0.1043245"
        rpy="0 0 0" />
      <mass value="2.27318682" />
      <inertia
        ixx="0.00958641"
        ixy="-1.02E-06"
        ixz="9.85E-06"
        iyy="0.00938072"
        iyz="-0.00057588"
        izz="0.00344789" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J1-J2.STL" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J1-J2.STL" />
        </geometry>
      </collision>
    </link>
      <joint
      name="${prefix}joint_1"
      type="revolute">
        <origin
          xyz="0 0 0.11"
          rpy="0 0 0" />
        <parent link="${prefix}base_link"/>
        <child link="${prefix}link_J1-J2" />
        <axis xyz="0 0 1"/>
        <limit
          lower="-6.284"
          upper="6.284"
          effort="107"
          velocity="3.142" />
      </joint>
    <link name="${prefix}link_J2-J3">
      <inertial>
        <origin
        xyz="3.09E-05 -0.10589631 0.01372831"
        rpy="0 0 0" />
      <mass
        value="2.00654949" />
      <inertia
        ixx="0.0180855"
        ixy="-1.095E-05"
        ixz="-1.65E-06"
        iyy="0.0028588"
        iyz="0.00272402"
        izz="0.01799154" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J2-J3.STL" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J2-J3.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}joint_2"
      type="revolute">
      <origin 
        xyz="0 0 0.145"
        rpy="-1.5708 0 0" />
      <parent
        link="${prefix}link_J1-J2" />
      <child
        link="${prefix}link_J2-J3" />
      <axis
      xyz="0 0 1" />
    <limit
      lower="-1.9887"
      upper="1.9887"
      effort="107"
      velocity="3.142" />
    </joint>
    <link name="${prefix}link_J3-J4">
      <inertial>
        <origin
        xyz="5.03E-05 -0.00848511 0.13382916"
        rpy="0 0 0" />
      <mass
        value="1.76260891" />
      <inertia
        ixx="0.01223079"
        ixy="2.8E-07"
        ixz="5.52E-06"
        iyy="0.01190478"
        iyz="-0.00060176"
        izz="0.00233244" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J3-J4.STL"/>
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J3-J4.STL"/>
        </geometry>
      </collision>
    </link>
      <joint
        name="${prefix}joint_3"
        type="revolute">
        <origin
          xyz="0 -0.195 0"
          rpy="1.5708 0 0" />
        <parent
          link="${prefix}link_J2-J3" />
        <child
          link="${prefix}link_J3-J4" />
        <axis
          xyz="0 0 1" />
        <limit
          lower="${-2*PI}"
          upper="${2*PI}"
          effort="39"
          velocity="1.3963" />
      </joint>
    <link name="${prefix}link_J4-J5">
      <inertial>
        <origin
          xyz="-1.751E-05 -0.13040912 0.01582329"
          rpy="0 0 0" />
        <mass
          value="1.50663764" />
        <inertia
          ixx="0.02112524"
          ixy="3.68E-06"
          ixz="7.7E-07"
          iyy="0.0018132"
          iyz="0.00269567"
          izz="0.02090559" />
        </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J4-J5.STL" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J4-J5.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}joint_4"
      type="revolute">
      <origin
        xyz="0 0 0.195"
        rpy="-1.5708 0 0" />
      <parent
        link="${prefix}link_J3-J4" />
      <child
        link="${prefix}link_J4-J5" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2.4248"
        upper="2.4248"
        effort="70"
        velocity="4.712" />
    </joint>
    <link name="${prefix}link_J5-J6">
      <inertial>
        <origin
          xyz="1.244E-05 -0.00550579 0.07732853"
          rpy="0 0 0" />
        <mass
          value="1.00220259" />
        <inertia
          ixx="0.00228062"
          ixy="1.49E-06"
          ixz="-6.7E-07"
          iyy="0.00210517"
          iyz="-0.0001394"
          izz="0.00091029" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J5-J6.STL" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J5-J6.STL" />
        </geometry>
      </collision>
    </link>
      <joint
        name="${prefix}joint_5"
        type="revolute">
        <origin
          xyz="0 -0.255 0"
          rpy="1.5708 0 0" />
        <parent
          link="${prefix}link_J4-J5" />
        <child
          link="${prefix}link_J5-J6" />
        <axis
          xyz="0 0 1" />
        <limit
          lower="-6.284"
          upper="6.284"
          effort="36"
          velocity="6.284" />
      </joint>
    <link name="${prefix}link_J6-J7">
      <inertial>
        <origin
          xyz="0 -0.06442439 0.01002949"
          rpy="0 0 0" />
        <mass
          value="1.00220259" />
        <inertia
          ixx="0.00316497"
          ixy="-3.08E-06"
          ixz="-7.4E-07"
          iyy="0.00089527"
          iyz="0.00063875"
          izz="0.00300454" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J6-J7.STL" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J6-J7.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}joint_6"
      type="revolute">
      <origin
        xyz="0 0 0.105"
        rpy="-1.5708 0 0" />
      <parent
        link="${prefix}link_J5-J6" />
      <child
        link="${prefix}link_J6-J7" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-1.8317"
        upper="1.8317"
        effort="36"
        velocity="6.284" />
    </joint>
    <link name="${prefix}link_J7-TIF">
      <inertial>
        <origin
          xyz="-5.763E-05 4.382E-05 0.04822273"
          rpy="0 0 0" />
        <mass
          value="0.58506179" />
        <inertia
          ixx="0.00074281"
          ixy="0.00000013"
          ixz="-0.00000103"
          iyy="0.00074032"
          iyz="0.00000016"
          izz="0.00052184" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J7-TIF.STL" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://air_description/meshes/link3m/link_J7-TIF.STL" />
        </geometry>
      </collision>
    </link>
      <joint
        name="${prefix}joint_7"
        type="revolute">
        <origin
          xyz="0 -0.105 0"
          rpy="1.5708 0 0" />
        <parent
          link="${prefix}link_J6-J7" />
        <child
          link="${prefix}link_J7-TIF" />
        <axis
          xyz="0 0 1" />
        <limit
          lower="-6.284"
          upper="6.284"
          effort="36"
          velocity="6.284" />
      </joint>
    <link name="${prefix}end_effector_link" />
    <joint
      name="${prefix}end_effector"
      type="fixed">
      <origin
        xyz="0 0 0.096"
        rpy="0 0 0" />
      <parent
        link="${prefix}link_J7-TIF" />
      <child
        link="${prefix}end_effector_link" />
      <axis
        xyz="0 0 0" />
    </joint>
    <xacro:if value="${vision}">
      <!-- sim camera needs to be rotated which might not apply to built in vision module -->
      <xacro:if value="${sim_gazebo}">
        <link name="${prefix}camera_link" />
        <joint name="${prefix}camera_module" type="fixed">
          <origin xyz="0 0.05639 0.01305" rpy="0 ${-PI/2} ${-PI/2}" />
          <parent link="${prefix}end_effector_link" />
          <child  link="${prefix}camera_link" />
        </joint>
        <link name="${prefix}camera_depth_frame" />
        <joint name="${prefix}depth_module" type="fixed">
          <origin xyz="0.0275 0.066 0.01305" rpy="0 ${-PI/2} ${-PI/2}" />
          <parent link="${prefix}end_effector_link" />
          <child  link="${prefix}camera_depth_frame" />
        </joint>
        <link name="${prefix}camera_color_frame" />
        <joint name="${prefix}color_module" type="fixed">
          <origin xyz="0 0.05639 0.01305" rpy="0 ${-PI/2} ${-PI/2}" />
          <parent link="${prefix}end_effector_link" />
          <child  link="${prefix}camera_color_frame" />
        </joint>
      </xacro:if>
      <xacro:unless value="${sim_gazebo}">
        <link name="${prefix}camera_link" />
        <joint name="${prefix}camera_module" type="fixed">
          <origin xyz="0 0.05639 -0.00305" rpy="${PI} ${PI} 0" />
          <parent link="${prefix}end_effector_link" />
          <child  link="${prefix}camera_link" />
        </joint>
        <link name="${prefix}camera_depth_frame" />
        <joint name="${prefix}depth_module" type="fixed">
          <origin xyz="0.0275 0.066 -0.00305" rpy="${PI} ${PI} 0" />
          <parent link="${prefix}end_effector_link" />
          <child  link="${prefix}camera_depth_frame" />
        </joint>
        <link name="${prefix}camera_color_frame" />
        <joint name="${prefix}color_module" type="fixed">
          <origin xyz="0 0.05639 -0.00305" rpy="${PI} ${PI} 0" />
          <parent link="${prefix}end_effector_link" />
          <child  link="${prefix}camera_color_frame" />
        </joint>
      </xacro:unless>
    </xacro:if>
  </xacro:macro>
</robot>
